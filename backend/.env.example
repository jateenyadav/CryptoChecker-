# --- Django / backend ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Leave unset to use a local SQLite file for quick experiments.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://crypto:crypto@localhost:5432/cryptochecker

# CORS: the frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Market data provider
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
MARKET_CACHE_TTL=45

# GenAI. If unset, AI insights run in a deterministic rule-based fallback.
GEMINI_API_KEY=
